<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleDisplayName</key><string>Shelf Aware BT</string>
  <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
  <key>CFBundleURLTypes</key><array><dict>
    <key>CFBundleTypeRole</key><string>Editor</string>
    <key>CFBundleURLSchemes</key><array><string>shelfawarebt</string></array>
  </dict></array>
  <key>MWDAT</key><dict>
    <key>AppLinkURLScheme</key><string>shelfawarebt://</string>
    <key>MetaAppID</key><string>$(META_APP_ID)</string>
    <key>ClientToken</key><string>$(CLIENT_TOKEN)</string>
    <key>TeamID</key><string>$(DEVELOPMENT_TEAM)</string>
  </dict>
  <key>NSBluetoothAlwaysUsageDescription</key><string>Connect your Meta glasses for captures you request.</string>
  <key>NSBluetoothPeripheralUsageDescription</key><string>Connect your Meta glasses for captures you request.</string>
  <key>NSCameraUsageDescription</key><string>Take a product-label photo in the clearly labeled phone-camera fallback.</string>
  <key>NSMicrophoneUsageDescription</key><string>Use the shown microphone route when you press Speak or start a consented foreground conversation. Stop or leaving the app ends listening.</string>
  <key>NSSpeechRecognitionUsageDescription</key><string>Transcribe your shopping question after you press Speak. Apple may process this audio.</string>
  <!-- Keep LAN access for the backend. Omit the Meta Wi-Fi Bonjour service. -->
  <key>NSLocalNetworkUsageDescription</key><string>Connect to your local Shelf Aware backend.</string>
  <!-- Bluetooth Classic camera transport; no Hotspot/Wi-Fi Information entitlements. -->
  <key>UISupportedExternalAccessoryProtocols</key><array><string>com.meta.ar.wearable</string></array>
  <key>UIBackgroundModes</key><array><string>processing</string><string>bluetooth-central</string><string>bluetooth-peripheral</string><string>external-accessory</string></array>
  <!-- Development LAN only. Switch to HTTPS and remove this before distribution. -->
  <key>NSAppTransportSecurity</key><dict><key>NSAllowsArbitraryLoads</key><true/><key>NSAllowsLocalNetworking</key><true/></dict>
  <key>UILaunchScreen</key><dict/>
  <key>UIApplicationSceneManifest</key><dict><key>UIApplicationSupportsMultipleScenes</key><false/></dict>
  <key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string></array>
</dict></plist>
