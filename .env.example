# Copy to .env at this repository root. Never commit or paste actual keys into chat.
# The explicitly synthetic fixture mode runs without these keys.
PERCEPTRON_API_KEY=
PERCEPTRON_MODEL=perceptron-mk1.5

# Text guidance and catalog search are selected independently; no automatic fallback.
# Enter the key only in the private .env; never include it in source or shared URLs.
TEXT_PROVIDER=deepseek
CATALOG_SEARCH_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Opt in to higher-quality product wording with TEXT_PROVIDER=anthropic.
# Keep CATALOG_SEARCH_PROVIDER=deepseek and its key for public product searches.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_WORKSPACE_ID=

# Manual alternative: set TEXT_PROVIDER=gemini for wording and/or
# CATALOG_SEARCH_PROVIDER=gemini for Google Search explicitly.
# Provider failures NEVER trigger an automatic runtime fallback to Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional shared bearer token for a trusted LAN demo. Keep loopback default.
# If set, both the native client and web development proxy need the same token.
SHELF_API_TOKEN=

# Continuous conversation uses the existing product-search flow by default here.
CONVERSATION_PRODUCT_MODE=product_search
# Used only by reviewed_catalog mode; product_search uses TEXT_PROVIDER above.
CONVERSATION_REASONING_PROVIDER=deepseek
CONVERSATION_TRANSCRIPTION_PROVIDER=elevenlabs
CONVERSATION_SPEECH_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_TTS_MODEL=eleven_v4_turbo
# Optional older streaming adapter: ELEVENLABS_TTS_MODEL=eleven_flash_v2_5.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Optional reviewed-catalog mode requires actual reviewed package facts:
# CONVERSATION_PRODUCT_MODE=reviewed_catalog
# SHELF_CATALOG_PATH=private-media/catalog.json
